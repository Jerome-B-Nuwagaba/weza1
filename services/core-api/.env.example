# Copy to .env for local development. Never commit real secrets.
ENV=local
DATABASE_URL=postgresql://postgres:@127.0.0.1:5432/weza
SECRET_KEY=change-me-to-a-long-random-string
VAULT_MASTER_KEY=change-me-base64-32-bytes
BLIND_INDEX_KEY=change-me-another-random-string
CORS_ORIGINS=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3000
RUN_WORKER_INPROCESS=true
SEED_DEMO=true
DEMO_MODE=true
OTP_DELIVERY=display
# Optional — enables the full conversational AI (WEZA works without it)
ANTHROPIC_API_KEY=
# ---------------------------------------------------------------------------------------------
# WhatsApp Business Platform (Cloud API). REPLACE_ME, empty or unset = NOT CONFIGURED: the app stays in
# simulator mode and never calls Meta. Real values go ONLY in your untracked services/core-api/.env.
# >>> USER INPUT REQUIRED: fill the WHATSAPP_* values below (Meta developer dashboard, see each line).
# ---------------------------------------------------------------------------------------------
# Meta app → App settings → Basic → "App secret". Signs inbound webhooks (X-Hub-Signature-256).
WHATSAPP_APP_SECRET=REPLACE_ME
# Any string you invent; paste the same value into Meta → WhatsApp → Configuration → Webhook "Verify token".
WHATSAPP_VERIFY_TOKEN=REPLACE_ME
# Meta → WhatsApp → API Setup → access token (use a permanent system-user token outside quick tests).
WHATSAPP_TOKEN=REPLACE_ME
# Meta → WhatsApp → API Setup → "Phone number ID" (an id, not the phone number).
WHATSAPP_PHONE_NUMBER_ID=REPLACE_ME
# Graph API version used for sending (optional; default v21.0).
WHATSAPP_API_VERSION=v21.0
# Business number customers message, digits only with country code, e.g. 2567XXXXXXXX (landing-page link, step f).
WHATSAPP_BUSINESS_NUMBER=REPLACE_ME
# WhatsApp Business Account id — only needed later for message templates (optional).
WHATSAPP_BUSINESS_ACCOUNT_ID=REPLACE_ME

# ---------------------------------------------------------------------------------------------
# SMS / OTP delivery. console = OTP is shown in the simulator/dev bubble, nothing is sent.
# >>> USER INPUT REQUIRED: choose a provider and fill its credentials (the provider-agnostic slot is notification/sms.py).
# ---------------------------------------------------------------------------------------------
SMS_PROVIDER=console
SMS_API_KEY=REPLACE_ME
SMS_USERNAME=REPLACE_ME
SMS_SENDER_ID=REPLACE_ME
