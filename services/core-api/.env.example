# Copy to .env for local development. Never commit real secrets.
ENV=local
DATABASE_URL=postgresql://postgres:@127.0.0.1:5432/weza
SECRET_KEY=change-me-to-a-long-random-string
VAULT_MASTER_KEY=change-me-base64-32-bytes
BLIND_INDEX_KEY=change-me-another-random-string
CORS_ORIGINS=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3000
RUN_WORKER_INPROCESS=true
SEED_DEMO=true
DEMO_MODE=true
OTP_DELIVERY=display
# Optional — enables the full conversational AI (WEZA works without it)
ANTHROPIC_API_KEY=
# Optional — WhatsApp Business Platform (Cloud API)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# SMS (OTP and customer updates): console | africastalking | twilio | infobip. Set OTP_DELIVERY=sms with a real provider.
SMS_PROVIDER=console
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
INFOBIP_BASE_URL=
INFOBIP_API_KEY=
INFOBIP_SENDER=
# Staff email alerts: smtp://user:pass@host:587 (STARTTLS) or smtps://user:pass@host:465 (TLS)
SMTP_URL=
SMTP_FROM=
# Document malware scanning: basic (test only) | clamav (production, needs clamd)
MALWARE_SCANNER=basic
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
