# Copy to .env for local development. Never commit real secrets.
ENV=local
DATABASE_URL=postgresql://postgres:@127.0.0.1:5432/weza
SECRET_KEY=change-me-to-a-long-random-string
VAULT_MASTER_KEY=change-me-base64-32-bytes
BLIND_INDEX_KEY=change-me-another-random-string
CORS_ORIGINS=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3000
RUN_WORKER_INPROCESS=true
SEED_DEMO=true
DEMO_MODE=true
OTP_DELIVERY=display
# Optional — enables the full conversational AI (WEZA works without it)
ANTHROPIC_API_KEY=
# Optional — WhatsApp Business Platform (Cloud API)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
