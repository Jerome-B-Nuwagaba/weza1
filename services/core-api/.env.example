# Copy to .env for local development. Never commit real secrets.
ENV=local
DATABASE_URL=postgresql://postgres:@127.0.0.1:5432/weza
SECRET_KEY=change-me-to-a-long-random-string
VAULT_MASTER_KEY=change-me-base64-32-bytes
BLIND_INDEX_KEY=change-me-another-random-string
CORS_ORIGINS=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3000
RUN_WORKER_INPROCESS=true
SEED_DEMO=true
DEMO_MODE=true
OTP_DELIVERY=display
# Real (non-demo) environments only: the first WEZA administrator, created once on start (python -m weza.bootstrap).
# >>> USER INPUT REQUIRED: a real email and a strong password (12+ characters); remove the password afterwards.
BOOTSTRAP_ADMIN_EMAIL=REPLACE_ME
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_ME
# Optional — enables the full conversational AI (WEZA works without it)
ANTHROPIC_API_KEY=
# ---------------------------------------------------------------------------------------------
# WhatsApp Business Platform (Cloud API). REPLACE_ME, empty or unset = NOT CONFIGURED: the app stays in
# simulator mode and never calls Meta. Real values go ONLY in your untracked services/core-api/.env.
# >>> USER INPUT REQUIRED: fill the WHATSAPP_* values below (Meta developer dashboard, see each line).
# ---------------------------------------------------------------------------------------------
# Meta app → App settings → Basic → "App secret" (32 hex characters). Signs inbound webhooks (X-Hub-Signature-256).
WHATSAPP_APP_SECRET=REPLACE_ME
# Any string you invent; paste the same value into Meta → WhatsApp → Configuration → Webhook "Verify token".
WHATSAPP_VERIFY_TOKEN=REPLACE_ME
# Meta → WhatsApp → API Setup → access token. The one shown there expires in ~24 h: for real use create a System User
# token (Business Settings → System users) with whatsapp_business_messaging + whatsapp_business_management, no expiry.
WHATSAPP_TOKEN=REPLACE_ME
# Meta → WhatsApp → API Setup → "Phone number ID" (an id, not the phone number).
WHATSAPP_PHONE_NUMBER_ID=REPLACE_ME
# Graph API version used for sending (optional; default v25.0, supported until 2028-07-29).
WHATSAPP_API_VERSION=v25.0
# Business number customers message, digits only with country code, e.g. 2567XXXXXXXX (landing-page link, step f).
WHATSAPP_BUSINESS_NUMBER=REPLACE_ME
# Approved AUTHENTICATION template name for verification codes (needed when the customer has not messaged you in
# the last 24 hours, e.g. journeys started on the web). >>> USER INPUT REQUIRED: create it in Meta WhatsApp Manager.
WHATSAPP_OTP_TEMPLATE_NAME=REPLACE_ME
WHATSAPP_OTP_TEMPLATE_LANGUAGE=en
# WhatsApp Business Account id — templates and scripts/whatsapp_account_check.py (read-only status check).
WHATSAPP_BUSINESS_ACCOUNT_ID=REPLACE_ME
# Embedded Signup (Admin → WhatsApp connection) to connect the WhatsApp Business app number (coexistence). Not secrets.
# Meta app → App settings → Basic → "App ID".
WHATSAPP_APP_ID=REPLACE_ME
# Meta app → Facebook Login for Business → Configurations → the "WhatsApp Embedded Signup" configuration's ID.
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=REPLACE_ME

# ---------------------------------------------------------------------------------------------
# SMS / OTP delivery. console = OTP is shown in the simulator/dev bubble, nothing is sent.
# >>> USER INPUT REQUIRED: choose a provider and fill its credentials (the provider-agnostic slot is notification/sms.py).
# ---------------------------------------------------------------------------------------------
# whatsapp = send verification codes through the Meta WhatsApp API (uses the WHATSAPP_* values above).
SMS_PROVIDER=console
SMS_API_KEY=REPLACE_ME
SMS_USERNAME=REPLACE_ME
SMS_SENDER_ID=REPLACE_ME

# ---------------------------------------------------------------------------------------------
# Credit Reference Bureau (GnuGrid CRB Enquiries API v1.08) — advisory identity check (KYC enquiry).
# Empty / REPLACE_ME = not configured: the identity step is skipped and nothing is sent to the bureau.
# >>> USER INPUT REQUIRED. LIVE enquiries are CHARGED per SUCCESSFUL request — never use live values in tests.
# ---------------------------------------------------------------------------------------------
# Base URL from GnuGrid (https only, without /v1), e.g. https://<gnugrid-host>/api
CRB_BASE_URL=REPLACE_ME
CRB_CLIENT_ID=REPLACE_ME
CRB_CLIENT_SECRET=REPLACE_ME
# Sent as the mandatory `reason` of every enquiry (agree the exact wording with GnuGrid/legal).
CRB_ENQUIRY_REASON=REPLACE_ME
# Aggregators only: the institution code sent as `pi_code` (e.g. CB000, MDI000, SACCO000).
CRB_PI_CODE=REPLACE_ME
